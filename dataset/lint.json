{
  "_doc": "Checks applied by benchmark/src/build_report.py to every projects/<lang>/app (never to app-patched, which may explain its fixes). 'anywhere' patterns are searched in file paths, code, identifiers and comments; 'comments' patterns only in comments and in the README. All are case-insensitive Python regexes. 'allow' lists exact substrings that are tolerated (e.g. framework names). A pattern may opt out of case-insensitivity with an inline (?-i:...) group — used for the identifier patterns, so framework constants such as HttpStatus.BAD_REQUEST are not hits.",
  "anywhere": [
    "CWE-?\\d+",
    "\\bCVE-\\d{4}",
    "vulnerab",
    "exploit",
    "owasp",
    "\\bpwn",
    "backdoor",
    "\\bxss\\b",
    "\\bsqli\\b",
    "\\bssrf\\b",
    "\\bxxe\\b",
    "\\bidor\\b",
    "\\brce\\b",
    "deliberate",
    "intentional",
    "on purpose",
    "guinea.?pig",
    "test.?bed",
    "ground.?truth",
    "(?-i:\\b(bad|evil|tainted|unsanitized|unsafe|insecure|vuln)_[a-z0-9_]+)",
    "(?-i:\\b(bad|evil|tainted|unsanitized|insecure|vuln)[A-Z][A-Za-z0-9]+)",
    "security.?scan",
    "\\b(sast|dast)\\b"
  ],
  "comments": [
    "insecure",
    "\\bunsafe\\b",
    "dangerous",
    "injection",
    "sanitiz",
    "unvalidated",
    "no (input )?validation",
    "not (escaped|validated|sanitized|checked)",
    "should (be )?(escap|validat|sanitiz|check)",
    "\\bfixme\\b",
    "\\bhack\\b",
    "\\bxxx\\b",
    "todo.{0,40}(fix|secur|escap|validat|check|auth)",
    "bad practice",
    "security",
    "attacker",
    "malicious",
    "do not use in production",
    "not for production"
  ],
  "allow": [],
  "skip_dirs": [
    "node_modules",
    "vendor",
    "target",
    "bin",
    "obj",
    "dist",
    "build",
    ".git",
    "__pycache__",
    ".venv"
  ],
  "text_extensions": [
    ".py",
    ".js",
    ".mjs",
    ".cjs",
    ".ts",
    ".tsx",
    ".jsx",
    ".java",
    ".kt",
    ".cs",
    ".go",
    ".rs",
    ".php",
    ".rb",
    ".c",
    ".h",
    ".cc",
    ".cpp",
    ".hpp",
    ".swift",
    ".scala",
    ".html",
    ".htm",
    ".ejs",
    ".hbs",
    ".twig",
    ".erb",
    ".jinja",
    ".j2",
    ".vue",
    ".svelte",
    ".sql",
    ".yml",
    ".yaml",
    ".json",
    ".toml",
    ".ini",
    ".cfg",
    ".conf",
    ".xml",
    ".properties",
    ".gradle",
    ".env",
    ".sh",
    ".md",
    ".txt",
    ".csproj",
    ".mod",
    ".lock",
    "Dockerfile",
    "Makefile",
    "CMakeLists.txt"
  ],
  "readme": {
    "_doc": "Each required README topic: at least one '#' heading must match one of the regexes.",
    "required_sections": {
      "overview": [
        "overview",
        "about",
        "what",
        "description",
        "pr[ée]sentation",
        "features",
        "fonctionnalit"
      ],
      "build": [
        "build",
        "install",
        "setup",
        "construire",
        "compil"
      ],
      "run": [
        "run",
        "start",
        "launch",
        "usage",
        "lancer",
        "d[ée]marr",
        "getting started",
        "quick ?start"
      ],
      "urls": [
        "url",
        "endpoint",
        "route",
        "api"
      ],
      "api_docs": [
        "swagger",
        "openapi",
        "api doc",
        "api reference",
        "documentation"
      ]
    }
  }
}
