# guinea-pig benchmark — scanner toggles & settings.
# Copy to `.env` (read from the working directory; real env vars override it).
#
# Disable a scanner by setting its name — UPPER-CASED, with `-`/space -> `_` —
# to a falsey value (false/0/no/off/disable). See `python3 benchmark/src/benchmark.py list`
# for every scanner name and its current enabled/disabled state.

# --- disable scanners (uncomment to turn off) ---
# CODEQL=false                  # slow: builds a CodeQL DB per language
# ZAPROXY=false                 # DAST; needs docker
# NUCLEI=false                  # DAST
# CLAMAV=false                  # malware; needs the ClamAV virus DB (freshclam)
# CISCO_AI_SKILL_SCANNER=false  # skill scanner
# CHECKOV=false                 # IaC
# KINGFISHER=false
# TRUFFLEHOG=false
# NOSEY_PARKER=false
# YARA=false
# MCP_THREATS=false
# ANALYSIS=false                # AST/code-graph analysis
# REACHABLE_DEPS=false

# --- tuning ---
# DEEPSCAN_TIMEOUT=240                 # per-scanner timeout, seconds (default 900)
# DEEPSCAN_TIMEOUT_CODEQL=1800         # per-scanner override (DEEPSCAN_TIMEOUT_<NAME>)
# DEEPSCAN_PARALLEL=4                  # max scanners running in parallel
# DEEPSCAN_TOOLS_DIR=~/.local/share/deepscan/tools   # where installed binaries live
# DEEPSCAN_LOG_LEVEL=INFO              # or DEBUG